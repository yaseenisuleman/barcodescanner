<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Toolbar -->
    <style name="AppTheme.ToolBar.TextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/large_text_size</item>
    </style>

    <!-- TabLayout -->
    <style name="AppTheme.TabLayout.TextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/medium_text_size</item>
    </style>

    <!-- TextView: Title -->
    <style name="AppTheme.TextView.Appearance.Title.Primary" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/medium_text_size</item>
    </style>

    <style name="AppTheme.TextView.Appearance.Title.Variant" parent="TextAppearance.Material3.TitleSmall">
        <item name="textColor">?colorPrimary</item>
        <item name="android:textColor">?colorPrimary</item>
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- TextView: Subtitle -->
    <style name="AppTheme.TextView.Appearance.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="textColor">?android:attr/textColorSecondary</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- TextView: Normal Text -->
    <style name="AppTheme.TextView.Appearance.Normal.Primary" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <style name="AppTheme.TextView.Appearance.Normal.Link" parent="AppTheme.TextView.Appearance.Normal.Primary">
        <item name="textColor">?android:attr/textColorLink</item>
        <item name="android:textColor">?android:attr/textColorLink</item>
    </style>

    <style name="AppTheme.TextView.Appearance.Normal.Error" parent="AppTheme.TextView.Appearance.Normal.Primary">
        <item name="android:textColor">?colorNegative</item>
    </style>

    <style name="AppTheme.TextView.Appearance.Normal.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="textColor">?android:attr/textColorSecondary</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- CardView -->
    <style name="AppTheme.CardView.Material3" parent="@style/Widget.Material3.CardView.Elevated">
        <item name="cardUseCompatPadding">true</item>
        <item name="cardCornerRadius">@dimen/card_standard_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="strokeColor">?colorOutlineVariant</item>
    </style>

    <!-- AppBarLayout -->
    <style name="AppTheme.AppBarLayout.Style" parent="Widget.Material3.AppBarLayout" />

    <!-- BottomNavigationView -->
    <style name="AppTheme.BottomNavigationView.Style" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/AppTheme.BottomNavigationView.ActiveIndicator.Style</item>
        <item name="backgroundTint">?colorSurfaceContainerLowest</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemRippleColor">?colorPrimaryContainer</item>
    </style>

    <style name="AppTheme.BottomNavigationView.ActiveIndicator.Style" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="AppTheme.BottomNavigationView.Label.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/label_text_size</item>
    </style>

    <style name="AppTheme.BottomNavigationView.Label.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/label_text_size</item>
    </style>

    <!-- NavigationRailView -->
    <style name="AppTheme.NavigationRailView.Style" parent="Widget.Material3.NavigationRailView">
        <item name="itemActiveIndicatorStyle">@style/AppTheme.NavigationRailView.ActiveIndicator.Style</item>
    </style>

    <style name="AppTheme.NavigationRailView.ActiveIndicator.Style" parent="Widget.Material3.NavigationRailView.ActiveIndicator" />

    <!-- Slider -->
    <style name="AppTheme.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">?colorPrimary</item>
        <item name="trackColor">?colorSecondaryContainer</item>
        <item name="haloColor">?colorSecondaryContainer</item>
    </style>

    <style name="AppTheme.SeekBarPreferenceCompat.Material3" parent="Preference.SeekBarPreference.Material">
        <item name="showSeekBarValue">true</item>
    </style>

    <!-- Switch -->
    <style name="AppTheme.Switch.Material3" parent="Widget.Material3.CompoundButton.MaterialSwitch" />

    <style name="AppTheme.SwitchPreferenceCompat.Material3" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/template_preference_material_switch</item>
    </style>

    <!-- Chip -->
    <style name="AppTheme.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?colorSurfaceContainerLow</item>
        <item name="chipStrokeColor">?colorOutlineVariant</item>
        <item name="chipCornerRadius">@dimen/text_input_corner_radius</item>
        <item name="android:textAppearance">@style/AppTheme.Chip.Text</item>
    </style>

    <style name="AppTheme.Chip.Text" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- TextInputLayout -->
    <style name="AppTheme.TextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="startIconTint">?android:textColorSecondary</item>
        <item name="boxCornerRadiusTopStart">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/text_input_corner_radius</item>
    </style>

    <style name="AppTheme.TextInputLayoutStyle.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="startIconTint">?android:textColorSecondary</item>
        <item name="boxCornerRadiusTopStart">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/text_input_corner_radius</item>
    </style>

    <style name="AppTheme.InputEditTextCaptionFont" parent="">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- AutoCompleteTextView -->
    <style name="AppTheme.AutoCompleteTextView.TextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="materialThemeOverlay">@style/AppTheme.AutoCompleteTextView.TextInputLayoutThemeOverlay</item>
        <item name="boxCornerRadiusTopStart">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/text_input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/text_input_corner_radius</item>
    </style>

    <style name="AppTheme.AutoCompleteTextView.TextInputLayoutThemeOverlay" parent="">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu</item>
    </style>

    <!-- Material Button -->
    <style name="AppTheme.MaterialButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <style name="AppTheme.MaterialButton.Large">
        <item name="android:minHeight">@dimen/button_large_height</item>
        <item name="android:textSize">@dimen/medium_text_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/medium_margin</item>
    </style>

    <style name="AppTheme.MaterialButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_large_height</item>
        <item name="strokeColor">?colorPrimary</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="iconTint">?colorPrimary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/medium_margin</item>
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- Tile button (Torch, Gallery) -->
    <style name="AppTheme.MaterialButton.Tile" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/tile_button_height</item>
        <item name="strokeColor">@color/format_chip_stroke</item>
        <item name="backgroundTint">@color/format_chip_background</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="iconTint">?colorOnSurface</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">@dimen/small_margin</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- Scan format chip -->
    <style name="AppTheme.Chip.Format" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/format_chip_background</item>
        <item name="chipStrokeColor">@color/format_chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_width</item>
        <item name="chipCornerRadius">@dimen/button_corner_radius</item>
        <item name="chipMinHeight">@dimen/format_chip_height</item>
        <item name="chipIconTint">@color/format_chip_text</item>
        <item name="chipIconVisible">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/format_chip_text</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Status badge (Synced, Pending) -->
    <style name="AppTheme.TextView.Badge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:background">@drawable/status_badge</item>
        <item name="android:backgroundTint">?colorPrimaryContainer</item>
        <item name="android:textColor">?colorOnPrimaryContainer</item>
        <item name="android:textSize">@dimen/label_text_size</item>
        <item name="android:drawablePadding">@dimen/small_margin</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Section label (SCAN FORMAT) -->
    <style name="AppTheme.TextView.Appearance.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:textSize">@dimen/label_text_size</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Large value (Quantity, barcode) -->
    <style name="AppTheme.TextView.Appearance.Value" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- DialogTextButtonStyle -->
    <style name="AppTheme.Dialog.TextButton.Style" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/normal_text_size</item>
    </style>

    <!-- DialogTitleStyle -->
    <style name="AppTheme.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text.CenterStacked">
        <item name="fontFamily">@string/title_font</item>
        <item name="android:fontFamily">@string/title_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/large_text_size</item>
    </style>

    <!-- AlertDialog -->
    <style name="AppTheme.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <!-- Overlay -->
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_corner_radius</item>
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="android:colorBackground">?colorSurfaceContainerHigh</item>
        <item name="android:windowElevation">6dp</item>

        <!-- Title Text -->
        <item name="materialAlertDialogTitleTextStyle">@style/AppTheme.Dialog.Title</item>

        <!-- Pour les checked button dans preferences -->
        <item name="android:checkedTextViewStyle">@style/AppTheme.TextView.Appearance.Normal.Primary</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AppTheme.TextView.Appearance.Normal.Primary</item>

        <!-- Buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/AppTheme.MaterialButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppTheme.Dialog.TextButton.Style</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppTheme.Dialog.TextButton.Style</item>
    </style>

    <!-- Overflow Menu (Placement de Item Menu) -->
    <style name="OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4.0dp</item>
    </style>

</resources>
