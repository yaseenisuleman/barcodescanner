<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.views.fragments.main.MainBarcodeHistoryFragment">

    <!-- Empty history -->
    <LinearLayout
        android:id="@+id/fragment_main_history_empty_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/history_empty_bottom_offset"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/history_empty_horizontal_padding"
        android:paddingEnd="@dimen/history_empty_horizontal_padding"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/history_empty_graphic_size"
            android:layout_height="@dimen/history_empty_graphic_size"
            android:background="@drawable/history_empty_graphic_background">

            <ImageView
                android:layout_width="@dimen/history_empty_icon_size"
                android:layout_height="@dimen/history_empty_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/baseline_history_24"
                app:tint="?colorPrimary"
                android:contentDescription="@string/image_view_description_icon" />

            <ImageView
                android:layout_width="@dimen/history_empty_badge_size"
                android:layout_height="@dimen/history_empty_badge_size"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/normal_margin"
                android:padding="@dimen/normal_margin"
                android:background="@drawable/icon_badge"
                android:backgroundTint="?colorSurfaceContainerLowest"
                android:src="@drawable/ic_bar_code_24"
                app:tint="?colorOnSurfaceVariant"
                android:contentDescription="@string/image_view_description_icon" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/large_margin"
            android:text="@string/history_empty_title"
            android:textAlignment="center"
            android:textSize="@dimen/large_text_size"
            style="@style/AppTheme.TextView.Appearance.Title.Primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:text="@string/history_empty_message"
            android:textAlignment="center"
            style="@style/AppTheme.TextView.Appearance.Normal.Secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fragment_main_history_start_scanning_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/large_margin"
            android:paddingStart="@dimen/history_empty_button_padding"
            android:paddingEnd="@dimen/history_empty_button_padding"
            android:text="@string/history_empty_button"
            app:icon="@drawable/baseline_qr_code_scanner_24"
            style="@style/AppTheme.MaterialButton.Large" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fragment_main_history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start|top"
        android:clipToPadding="false"
        android:clipChildren="false" />
</FrameLayout>