<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/recycler_view_item_history_barcode_background_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/normal_margin">

        <TextView
            android:id="@+id/recycler_view_item_history_barcode_delete_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/recycler_view_item_history_barcode_delete_icon_image_view"
            android:textAlignment="viewStart"
            android:text="@string/delete_label"
            style="@style/AppTheme.TextView.Appearance.Normal.Primary" />

        <ImageView
            android:id="@+id/recycler_view_item_history_barcode_delete_icon_image_view"
            android:layout_width="@dimen/icon_standard_size"
            android:layout_height="@dimen/icon_standard_size"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/baseline_delete_forever_24"
            android:contentDescription="@string/image_view_description_icon" />

    </RelativeLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recycler_view_item_history_barcode_foreground_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardUseCompatPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/medium_margin">

            <ImageView
                android:id="@+id/recycler_view_item_history_barcode_image_view"
                android:layout_width="@dimen/history_item_image_size"
                android:layout_height="@dimen/history_item_image_size"
                android:padding="@dimen/medium_margin"
                android:background="@drawable/icon_badge"
                app:backgroundTint="?colorPrimaryContainer"
                app:tint="?colorOnPrimaryContainer"
                android:contentDescription="@string/image_view_description_type_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Format (ex: QR_CODE) -->
            <TextView
                android:id="@+id/recycler_view_item_history_barcode_format_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_marginEnd="@dimen/normal_margin"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                tools:text="QR_CODE"
                style="@style/AppTheme.TextView.Appearance.Normal.Secondary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/recycler_view_item_history_barcode_image_view"
                app:layout_constraintEnd_toStartOf="@id/recycler_view_item_history_barcode_icon_image_view" />

            <ImageView
                android:id="@+id/recycler_view_item_history_barcode_icon_image_view"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:padding="@dimen/small_margin"
                android:background="@drawable/status_badge"
                app:tint="?colorOnPrimaryContainer"
                android:contentDescription="@string/image_view_description_bar_code"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/recycler_view_item_history_barcode_entitled_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_marginTop="@dimen/thin_margin"
                android:layout_marginEnd="@dimen/normal_margin"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                tools:text="Website"
                style="@style/AppTheme.TextView.Appearance.Title.Primary"
                app:layout_constraintTop_toBottomOf="@id/recycler_view_item_history_barcode_format_text_view"
                app:layout_constraintStart_toEndOf="@id/recycler_view_item_history_barcode_image_view"
                app:layout_constraintEnd_toStartOf="@id/recycler_view_item_history_barcode_chevron_image_view" />

            <TextView
                android:id="@+id/recycler_view_item_history_barcode_content_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_marginTop="@dimen/thin_margin"
                android:layout_marginEnd="@dimen/small_margin"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                tools:text="https://example.com"
                style="@style/AppTheme.TextView.Appearance.Normal.Secondary"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintTop_toBottomOf="@id/recycler_view_item_history_barcode_entitled_text_view"
                app:layout_constraintStart_toEndOf="@id/recycler_view_item_history_barcode_image_view"
                app:layout_constraintEnd_toStartOf="@id/recycler_view_item_history_barcode_origin_flag_image_view" />

            <ImageView
                android:id="@+id/recycler_view_item_history_barcode_origin_flag_image_view"
                android:layout_width="@dimen/icon_light_size"
                android:layout_height="@dimen/icon_light_size"
                android:layout_marginEnd="@dimen/normal_margin"
                android:contentDescription="@string/image_view_description_flag"
                app:layout_constraintTop_toTopOf="@id/recycler_view_item_history_barcode_content_text_view"
                app:layout_constraintBottom_toBottomOf="@id/recycler_view_item_history_barcode_content_text_view"
                app:layout_constraintStart_toEndOf="@id/recycler_view_item_history_barcode_content_text_view"
                app:layout_constraintEnd_toStartOf="@id/recycler_view_item_history_barcode_chevron_image_view" />

            <ImageView
                android:id="@+id/recycler_view_item_history_barcode_chevron_image_view"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/outline_chevron_right_24"
                app:tint="?colorOnSurfaceVariant"
                android:contentDescription="@string/image_view_description_icon"
                app:layout_constraintTop_toTopOf="@id/recycler_view_item_history_barcode_entitled_text_view"
                app:layout_constraintBottom_toBottomOf="@id/recycler_view_item_history_barcode_content_text_view"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/recycler_view_item_history_barcode_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="recycler_view_item_history_barcode_image_view,recycler_view_item_history_barcode_content_text_view" />

            <!-- Date -->
            <TextView
                android:id="@+id/recycler_view_item_history_barcode_date_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:drawableStart="@drawable/baseline_history_24"
                android:drawablePadding="@dimen/small_margin"
                android:drawableTint="?colorOnSurfaceVariant"
                android:gravity="center_vertical"
                tools:text="22/10/2026"
                style="@style/AppTheme.TextView.Appearance.Normal.Secondary"
                app:layout_constraintTop_toBottomOf="@id/recycler_view_item_history_barcode_barrier"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
