<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="?colorPrimaryContainer"/>
        </shape>
    </item>
    <!-- Inner disc -->
    <item
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="?colorSurfaceContainerLowest"/>
            <stroke android:width="@dimen/stroke_width"
                android:color="?colorOutlineVariant" />
        </shape>
    </item>
</layer-list>
